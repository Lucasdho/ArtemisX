--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3f3519c53f5d4320802b81d24266d9b, type: 3}
  m_Name: ScreensConfig
  m_EditorClassIdentifier: Assembly-CSharp::ArtemisX.UI.ScreensConfig
  titleName: ARTEMIS X
  titleSubtitle: Junior Astronaut Mission Trainer
  titlePlayLabel: PLAY
  titleOrbitCenter: {x: 0.5, y: 0, z: 0.5}
  titleOrbitDistance: 38
  titleOrbitPitch: 35
  titleOrbitDegreesPerSecond: 4
  titleFloatPixels: 6
  titleFloatHz: 0.5
  titlePlayPulseScale: 1.04
  titlePlayPulseHz: 1
  introFocusOffset: {x: 0, y: 1, z: 0}
  introStartDistance: 6
  introEndDistance: 22
  introStartYawOffset: -90
  introEndYawOffset: 0
  introStartPitch: 32
  introEndPitch: 38
  introOrbitSeconds: 12
  introReturnSeconds: 2.5
  landerStartHeight: 14
  landerDescentSeconds: 4.5
  skipLabel: SKIP >>
  goalLines:
  - player: 0
    mood: 1
    text: First, here is our training checklist! Complete these 4 steps to get the
      base running, then your main missions unlock.
  goalHint: GOAL (1/6)  3 Modules = 3 Stars
  buildNextLines:
  - player: 0
    mood: 1
    text: Build here next! The glowing ring marks the Processing Plant.
  - player: 0
    mood: 0
    text: Moon rocks and polar ice lock up metals and water. Refining them here gives
      us Water and Parts without Earth rockets!
  buildNextHint: BUILD NEXT (2/6)  Processing Plant (15 Parts, 20 Power)
  step1Lines:
  - player: 0
    mood: 0
    text: 'How to get Power: watch space weather! Real NASA DONKI data warns us of
      storms.'
  - player: 0
    mood: 0
    text: "Solar panels power our base and machines. On storm days, retract them
      to stay safe\u2014tap the solar field to see."
  step1WeatherHint: RESOURCES (3/6)  Space weather & Power
  step1Hint: RESOURCES (3/6)  Tap the solar panels
  step2Lines:
  - player: 0
    mood: 1
    text: 'How to get Parts & Water: tap the Rover button and send Luna to Ice or
      Mineral sites!'
  - player: 0
    mood: 0
    text: That's how you gather what the Processing Plant needs. Far sites carry
      more, at higher Power and breakdown risk.
  step2Hint: RESOURCES (4/6)  Tap the Rover button
  supplyLines:
  - player: 0
    mood: 1
    text: Important tip, {playerName}! Every 5 days, Earth launches a supply capsule
      to our left landing pad packed with Food and Parts.
  - player: 0
    mood: 0
    text: "A starter drop just landed! Whenever new cargo is waiting, tap the jumping
      crate icon to pan straight to it\u2014then tap the crate or icon again to collect!"
  supplyAlertHint: SUPPLY CARGO (5/6)  Tap the jumping cargo icon
  supplyCollectHint: SUPPLY CARGO (5/6)  Tap the cargo crate or icon to open it
  step3Lines:
  - player: 0
    mood: 1
    text: Press Next Day to finish your shift. Overnight, Luna returns with cargo
      and solar panels recharge!
  step3Hint: NEXT SHIFT (6/6)  Press Next Day
  doneLines:
  - player: 0
    mood: 1
    text: "Training done, {playerName}! Your 3 main missions are now active\u2014earn
      3 Stars by building the Processing Plant, Electrolyser, and Terraforming Dome!"
  replayLine: Welcome back, {playerName}! Day 1 again. Can you beat your last run?
  earlyWinTitle: Mission complete!
  dayCapTitle: Mission extended
  earlyWinSubtitle: Base self-sufficient in {0} days!
  dayCapSubtitle: 'Day {0}: {1} of 3 buildings built. Mission extended!'
  gradeLines:
  - player: 0
    mood: 2
    text: No buildings yet, but every astronaut learns by trying. Start with the
      Processing Plant next time!
  - player: 0
    mood: 0
    text: "One star! Processing Plant online\u2014turning moon rocks and ice into
      Parts and Water. Aim for the Electrolyser next!"
  - player: 0
    mood: 1
    text: Two stars! Processing Plant and Electrolyser are making Water, Parts, O2,
      and H2 fuel. Just the Terraforming Dome left!
  - player: 0
    mood: 1
    text: "Three stars! Processing, Electrolysis, and Terraforming\u2014the base
      lives on its own, {playerName}!"
  fastRunDay: 12
  fastRunLine:
    player: 0
    mood: 1
    text: Three stars in record time! Mission Control wants your autograph, {playerName}!
  histogramTitle: 'JUNIOR ASTRONAUTS WORLDWIDE: DAYS TO FINISH'
  loadingText: Connecting to the leaderboard...
  offlineText: Leaderboard offline. Showing your run only.
  onlineText: '{0} runs so far. Your bar is highlighted!'
  extendedBarLabel: EXT
  playAgainLabel: Play again
  barColor: {r: 0.5803922, g: 0.6392157, b: 0.72156864, a: 0.7}
  ownBarColor: {r: 1, g: 0.3529412, b: 0.12156863, a: 1}
  daysCaption: days
  builtCaption: built
  leaderboardButtonLabel: Leaderboard
  cardScaleFrom: 0.92
  cardScaleDuration: 0.18
  ribbonDropDelay: 0.12
  ribbonDropDuration: 0.2
  ribbonDropDistance: 60
  starPopScale: 1.2
  starPopDuration: 0.15
  raysTurnSeconds: 8
  leaderboardTitle: All missions
  leaderboardFasterLine: You finished on day {0}. That's faster than {1} in 10 players!
  leaderboardExtendedLine: Your mission was extended. {0} in 10 players needed more
    time too!
  leaderboardFirstCrewsLine: You're one of the first crews on the Moon!
  leaderboardOfflineLine: Leaderboard offline. Your run is saved for next time.
  leaderboardExtendedLabel: extended
  leaderboardDayLabel: day {0}
  leaderboardBackLabel: Back
  leaderboardMinRunsForStats: 5
  leaderboardFirstDay: 10
  leaderboardBarMaxHeight: 120
  leaderboardBarMinHeight: 2
  leaderboardBarWidth: 15
  leaderboardBarGap: 2
