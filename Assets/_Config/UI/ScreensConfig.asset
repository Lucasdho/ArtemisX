MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3f3519c53f5d4320802b81d24266d9b, type: 3}
  m_Name: ScreensConfig
  m_EditorClassIdentifier: Assembly-CSharp::ArtemisX.UI.ScreensConfig
  introFocusOffset: {x: 0, y: 1, z: 0}
  introStartDistance: 6
  introEndDistance: 22
  introStartYawOffset: -90
  introEndYawOffset: 0
  introStartPitch: 32
  introEndPitch: 38
  introOrbitSeconds: 12
  introReturnSeconds: 2.5
  skipLabel: SKIP >>
  step1Lines:
  - player: 0
    mood: 0
    text: 'Step 1: space weather! This panel shows the forecast for today, using real
      NASA DONKI data.'
  - player: 0
    mood: 0
    text: On storm days, retract the solar panels to protect them. Tap the solar
      panels to see how.
  step1WeatherHint: STEP 1/3  Space weather
  step1Hint: STEP 1/3  Tap the solar panels
  step2Lines:
  - player: 0
    mood: 1
    text: 'Step 2: exploring! Tap the Rover button, then pick a site on the map to
      send it out.'
  - player: 0
    mood: 0
    text: Far sites bring more, but cost more Power and break down more often. Your
      call!
  step2Hint: STEP 2/3  Tap the Rover button
  step3Lines:
  - player: 0
    mood: 1
    text: 'Step 3: press Next Day to end the shift. Watch the Moon go from day to
      night!'
  step3Hint: STEP 3/3  Press Next Day
  doneLines:
  - player: 0
    mood: 1
    text: Training done, {playerName}! Build the Water & O2 Plant first. The base
      is yours!
  replayLine: Welcome back, {playerName}! Day 1 again. Can you beat your last run?
  earlyWinTitle: MISSION COMPLETE
  dayCapTitle: MISSION EXTENDED
  earlyWinSubtitle: Base self-sufficient in {0} days!
  dayCapSubtitle: 'Day {0}: {1} of 3 buildings built. Mission extended!'
  gradeLines:
  - player: 0
    mood: 2
    text: No buildings yet, but every astronaut learns by trying. Let's train again!
  - player: 0
    mood: 0
    text: One star! Fresh water and air for the crew. Next time, aim for the Greenhouse
      too.
  - player: 0
    mood: 1
    text: Two stars! Water, air and food. Just the Fuel Reserve left to go home on
      our own!
  - player: 0
    mood: 1
    text: Three stars! The base runs on its own. You're a real lunar engineer, {playerName}!
  fastRunDay: 12
  fastRunLine:
    player: 0
    mood: 1
    text: Three stars in record time! Mission Control wants your autograph, {playerName}!
  histogramTitle: 'JUNIOR ASTRONAUTS WORLDWIDE: DAYS TO FINISH'
  loadingText: Connecting to the leaderboard...
  offlineText: Leaderboard offline. Showing your run only.
  onlineText: '{0} runs so far. Your bar is highlighted!'
  extendedBarLabel: EXT
  playAgainLabel: PLAY AGAIN
  barColor: {r: 0.5803922, g: 0.6392157, b: 0.72156864, a: 0.7}
  ownBarColor: {r: 1, g: 0.3529412, b: 0.12156863, a: 1}
