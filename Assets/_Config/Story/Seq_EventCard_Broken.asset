  m_Script: {fileID: 11500000, guid: 793928e1aac8946ba974934098abc7b9, type: 3}
  m_Name: Seq_EventCard_Broken
  m_EditorClassIdentifier: Assembly-CSharp::ArtemisX.Story.DialogueSequence
  sequenceId: event_broken_placeholder
  lines:
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 2
    text: A water filter is clogged! Fix it with Parts, or flush it with Water for
      now?
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 0
    text: Fixing costs Parts today. Flushing saves Parts but wastes Water.
  choices:
  - choiceId: repair_with_parts
    label: Fix (-8 Parts)
    resourceDeltas:
    - resource: 4
      delta: -8
    fixesBrokenComponent: 1
    outcomeSummary: Spending Parts cleared the fault so tomorrow starts clean.
  - choiceId: bypass_with_water
    label: Flush (-8 Water)
    resourceDeltas:
    - resource: 1
      delta: -8
    fixesBrokenComponent: 0
    outcomeSummary: Flushing saved Parts today, though the valve still needs service.
