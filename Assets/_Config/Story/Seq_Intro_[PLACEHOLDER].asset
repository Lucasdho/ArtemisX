  m_Script: {fileID: 11500000, guid: 793928e1aac8946ba974934098abc7b9, type: 3}
  m_Name: 'Seq_Intro_[PLACEHOLDER]'
  m_EditorClassIdentifier: Assembly-CSharp::ArtemisX.Story.DialogueSequence
  sequenceId: intro_day1
  lines:
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    text: '[PLACEHOLDER] Welcome to the lunar outpost, trainee. Systems are online.'
  - speaker: {fileID: 11400000, guid: e9491b65d8a9c4edfa921bee9056b201, type: 2}
    text: '[PLACEHOLDER] Solar arrays and life support are ready for our first day.'
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    text: '[PLACEHOLDER] Watch your five resources closely. Every choice matters.'
  - speaker: {fileID: 11400000, guid: e9491b65d8a9c4edfa921bee9056b201, type: 2}
    text: '[PLACEHOLDER] Let us begin the Day 1 morning check.'
  choices: []
