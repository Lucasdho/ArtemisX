  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 793928e1aac8946ba974934098abc7b9, type: 3}
  m_Name: Seq_Intro
  m_EditorClassIdentifier: Assembly-CSharp::ArtemisX.Story.DialogueSequence
  sequenceId: intro_day1
  lines:
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 1
    text: Touchdown! Welcome to the Moon, {playerName}. I'm Kepler, the computer
      that runs Artemis X Base.
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 0
    text: 'Small outposts exist up here, but none can live on its own yet. Our job:
      make this one self-sufficient!'
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 0
    text: 'Build 3 modules in order: Water & O2 Plant, Greenhouse, then Fuel Reserve.
      Each one earns a star.'
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 2
    text: 'We have 30 days. Every choice is a trade-off: Power, Water, Oxygen, Food
      and Parts are all limited.'
  - speaker: {fileID: 11400000, guid: e9491b65d8a9c4edfa921bee9056b201, type: 2}
    mood: 0
    text: Ready for duty, Kepler! Show me around.
  - speaker: {fileID: 11400000, guid: f1a52219a36a5425fbc0493a4d791c19, type: 2}
    mood: 1
    text: Let's start with a quick training day!
  choices: []
